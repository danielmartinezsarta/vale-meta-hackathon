# Copy to .env and fill in. Never commit .env or any secret.
META_API_KEY=
# Base URL of the private Glimmer endpoint (Modal or local llama-server).
# The token itself stays out of this file: export GLIMMER_TOKEN in the shell.
GLIMMER_URL=
# Optional: Modal URL of your own Seamless TTS deploy (modal deploy modal/seamless.py).
# Empty means the Seamless engine stays off and the browser voice says every line.
SEAMLESS_URL=
# The token itself stays out of this file: export SEAMLESS_TOKEN in the shell.
SEAMLESS_TOKEN=
