# Copy this file to .env and fill in what you need. Never commit .env.

# Required for the live app. Your Meta API key, used only on the server.
META_API_KEY=

# Optional. URL of your Glimmer endpoint, see docs/modal.md. Empty: client briefs are skipped.
GLIMMER_URL=

# Optional. Bearer token for the Glimmer endpoint.
GLIMMER_TOKEN=

# Optional. URL of your Seamless TTS endpoint, see docs/modal.md. Empty: the browser voice speaks.
SEAMLESS_URL=

# Optional. Bearer token for the Seamless endpoint.
SEAMLESS_TOKEN=

# Optional. Port for npm start, default 3000.
PORT=
